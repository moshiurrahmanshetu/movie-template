# ==============================================================================
# CineSphere - Apache Web Server Configuration (.htaccess)
# Phase 3: Clean Extensionless URLs, Performance & SEO Rewrite Rules
# ==============================================================================

# 1. Base Options & Directory Index
Options -Indexes +FollowSymLinks
DirectoryIndex index.html

# 2. Custom Error Page
ErrorDocument 404 /404.html

# 3. Default Character Encoding
AddDefaultCharset UTF-8

# ==============================================================================
# 4. Mod_Rewrite Rules (Clean Extensionless Routing)
# ==============================================================================
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 4.1 Do NOT rewrite real physical files (CSS, JS, fonts, images, etc.)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 4.2 Explicitly safeguard static asset directories from any rewrite
  RewriteCond %{REQUEST_URI} ^/(assets|css|js|images|fonts)/ [NC,OR]
  RewriteCond %{REQUEST_URI} \.(css|js|json|png|jpe?g|gif|svg|webp|ico|woff2?|ttf|eot|otf|xml|txt)$ [NC]
  RewriteRule ^ - [L]

  # 4.3 Support clean directory URLs without trailing slash:
  # e.g., /movies -> /movies/index.html
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.*)$ $1/index.html [L]

  # 4.4 Clean file rewrite without .html extension:
  # e.g., /404 -> /404.html
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.*)$ $1.html [L]

  # 4.5 Movie detail routing fallback:
  # e.g., /movie/custom-movie-slug -> /movie/index.html (with query preservation)
  RewriteRule ^movie/([a-zA-Z0-9_-]+)/?$ movie/index.html [L,QSA]

  # 4.6 Category genre routing fallback:
  # e.g., /category/custom-genre -> /category/index.html (with query preservation)
  RewriteRule ^category/([a-zA-Z0-9_-]+)/?$ category/index.html [L,QSA]
</IfModule>

# ==============================================================================
# 5. Performance: Gzip / Deflate Compression
# ==============================================================================
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript text/javascript
  AddOutputFilterByType DEFLATE application/json application/xml application/xhtml+xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ==============================================================================
# 6. Performance: Browser Caching (Expires Headers)
# ==============================================================================
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 day"
  
  # Media & Images
  ExpiresByType image/jpg "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/gif "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 year"

  # Stylesheets & JavaScript
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType text/javascript "access plus 1 week"

  # Web Fonts
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
</IfModule>

# ==============================================================================
# 7. Basic Security Headers
# ==============================================================================
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
